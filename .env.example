# Optional. When set, "Paste a solicitation" uses Claude to extract structured
# fields (every extracted fact must quote the pasted text, or it is dropped).
# Without it, a deterministic heuristic parser runs instead.
ANTHROPIC_API_KEY=

# Optional. Pin "today" for demos so deadlines and countdowns stay stable.
# Format YYYY-MM-DD. Leave blank to use the real date in America/Los_Angeles.
NEXT_PUBLIC_DEMO_TODAY=2026-10-03
